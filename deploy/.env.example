# 复制成 .env 后按需修改：cp .env.example .env
# 不建 .env 也能跑，下面全部有默认值

# Web 端口（宿主机端口，默认 8000）
WEB_PORT=8000

# 时区
TZ=Asia/Shanghai

# 数据目录（配置、日志、缓存、脚本都在这里，务必持久化）
DATA_DIR=./data

# 媒体库根目录：指向你自己的电影/视频目录，容器内为 /media
MEDIA_DIR=/volume1/media

# PostgreSQL 数据目录
PG_DIR=./pgdata

# 数据库账号密码（首次启动时生效，改完要清空 pgdata 才生效）
POSTGRES_DB=immortal
POSTGRES_USER=immortal
POSTGRES_PASSWORD=改成你自己的强密码

# 可选：Emby 数据目录（观看统计用）
# EMBY_DATA_DIR=/volume1/docker/emby/data

# 可选：抓取数据源的出网代理。留空表示直连。
# 支持 http:// 与 socks5://，例如：
# SCRAPE_PROXY=http://192.168.1.2:7890
SCRAPE_PROXY=

# 可选：FlareSolverr / 验证码求解服务，仅 X1080 等过盾源需要
# SCRAPE_SOLVER=http://192.168.1.2:8191/v1
SCRAPE_SOLVER=
